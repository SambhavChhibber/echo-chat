# ---- Key pool (failover order = list order) ---------------------------------
# Tip: Gemini quota is per Google Cloud *project*, so put each Gemini key in a
# different project (or mix providers), otherwise both keys hit 429 together.
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GROQ_API_KEYS=your-groq-key
# GEMINI_MODEL=gemini/gemini-3.5-flash-lite
# GROQ_MODEL=groq/llama-3.3-70b-versatile
PROVIDER_ORDER=gemini,groq

# Or describe the pool fully (overrides the above):
# LLM_POOL=[{"label":"Gemini A","model":"gemini/gemini-3.5-flash-lite","api_key":"..."},{"label":"Groq","model":"groq/llama-3.3-70b-versatile","api_key":"..."}]

# ---- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/chat.db
CACHE_TYPE=disk
CACHE_DIR=./data/llm_cache
CACHE_TTL_SECONDS=86400
COOLDOWN_SECONDS=30
REQUEST_TIMEOUT_SECONDS=45
MAX_CONTEXT_TOKENS=8000
RATE_LIMIT_PER_MINUTE=30
ENABLE_FAULT_INJECTION=true
# MOCK_MODE=true   # run without any keys
